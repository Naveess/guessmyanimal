# The service worker script itself must never be cached, or an update
# to it (a new VERSION, a new SHELL list) can't reach a returning
# visitor - browsers already special-case sw.js caching somewhat, but
# an explicit no-cache here removes any doubt.
/sw.js
  Cache-Control: no-cache

# Raw editorial content: content/ holds drafts (and reviewer notes) as
# well as reviewed entries, and data/ is the published copy app.js
# fetches. Both are for the page to use, not for search results.
/content/*
  X-Robots-Tag: noindex
/data/*
  X-Robots-Tag: noindex
